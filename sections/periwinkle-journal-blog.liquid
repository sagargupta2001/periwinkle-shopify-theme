{{ 'section-periwinkle-journal-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {%- assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic' -%}
  {%- if heading_font_italic -%}
    {{ heading_font_italic | font_face: font_display: 'swap' }}
  {%- endif -%}

  #PeriwinkleJournalIndex-{{ section.id }} {
    --journal-index-background: {{ section.settings.background_color }};
    --journal-index-text: {{ section.settings.text_color }};
    --journal-index-accent: {{ section.settings.accent_color }};
    --journal-index-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.75 }};
    --journal-index-line: {{ section.settings.text_color | color_modify: 'alpha', 0.16 }};
    --journal-index-fill: {{ section.settings.text_color | color_modify: 'alpha', 0.06 }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="PeriwinkleJournalIndex-{{ section.id }}"
  class="periwinkle-journal-index section-{{ section.id }}-padding"
>
  <div class="page-width">
    <header class="periwinkle-journal-index__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="periwinkle-journal-index__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="periwinkle-journal-index__heading">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ blog.title | escape }}
        {%- endif -%}
      </h1>
      {%- if section.settings.intro != blank -%}
        <div class="periwinkle-journal-index__intro">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- if section.settings.show_tags and blog.all_tags.size > 1 -%}
        <nav class="periwinkle-journal-index__tags" aria-label="Filter stories by topic">
          <ul role="list">
            <li>
              <a
                href="{{ blog.url }}"
                class="periwinkle-journal-index__tag"
                {% if current_tags == blank %}
                  aria-current="page"
                {% endif %}
              >
                All stories
              </a>
            </li>
            {%- for tag in blog.all_tags -%}
              <li>
                <a
                  href="{{ blog.url }}/tagged/{{ tag | handle }}"
                  class="periwinkle-journal-index__tag"
                  {% if current_tags contains tag %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- tag | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </header>

    {%- paginate blog.articles by section.settings.per_page -%}
      {%- liquid
        comment
          The newest story on the first page leads as a split card. It is kept
          moderate (image about 58% of the row) so the page reads as an index,
          not as the first article.
        endcomment
        assign show_featured = false
        if section.settings.feature_latest and paginate.current_page == 1 and blog.articles.size > 0
          assign show_featured = true
        endif

        assign rest_count = blog.articles.size
        if show_featured
          assign rest_count = rest_count | minus: 1
        endif
        assign grid_columns = 3
        if rest_count < 3
          assign grid_columns = 2
        endif
      -%}

      {%- if blog.articles.size == 0 -%}
        <p class="periwinkle-journal-index__empty">
          {%- if current_tags != blank -%}
            No stories under this topic yet. <a href="{{ blog.url }}">See all stories</a>
          {%- else -%}
            New stories are on the way.
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- for article in blog.articles -%}
        {%- liquid
          assign is_featured = false
          if show_featured and forloop.first
            assign is_featured = true
          endif

          assign reading_minutes = article.content | strip_html | split: ' ' | size | divided_by: 200 | at_least: 1
          if article.excerpt != blank
            assign summary = article.excerpt | strip_html
          else
            assign summary = article.content | strip_html | truncatewords: 32
          endif
          assign image_position = 'object-position: ' | append: article.image.presentation.focal_point
        -%}

        {%- capture card_meta -%}
          <p class="periwinkle-journal-index__meta">
            {%- if section.settings.show_date -%}
              <span>{{ article.published_at | time_tag: format: 'date' }}</span>
            {%- endif -%}
            <span>{{ reading_minutes }} min read</span>
          </p>
        {%- endcapture -%}

        {%- if is_featured -%}
          <article class="periwinkle-journal-index__featured">
            <div class="periwinkle-journal-index__media">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'eager',
                    widths: '375, 550, 750, 1000, 1300, 1600',
                    sizes: '(min-width: 1300px) 700px, (min-width: 990px) 55vw, calc(100vw - 3rem)',
                    alt: article.image.alt,
                    class: 'periwinkle-journal-index__image',
                    style: image_position
                }}
              {%- endif -%}
            </div>
            <div class="periwinkle-journal-index__featured-copy">
              <p class="periwinkle-journal-index__label">
                Latest story
                {%- if article.tags.size > 0 -%}
                  <span class="periwinkle-journal-index__label-topic">{{ article.tags.first | escape }}</span>
                {%- endif -%}
              </p>
              <h2 class="periwinkle-journal-index__featured-title">
                <a href="{{ article.url }}" class="periwinkle-journal-index__link">{{ article.title | escape }}</a>
              </h2>
              {{ card_meta }}
              <p class="periwinkle-journal-index__summary">{{ summary }}</p>
              <span class="periwinkle-journal-index__cta" aria-hidden="true">
                Read the story
                <span class="periwinkle-journal-index__cta-icon">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </span>
            </div>
          </article>

          {%- if rest_count > 0 -%}
            <h2 class="periwinkle-journal-index__more">{{ section.settings.more_heading | default: 'More stories' }}</h2>
          {%- endif -%}
        {%- else -%}
          {%- if forloop.first or show_featured and forloop.index == 2 -%}
            <ul class="periwinkle-journal-index__grid periwinkle-journal-index__grid--{{ grid_columns }}" role="list">
          {%- endif -%}

          <li class="periwinkle-journal-index__card">
            <article>
              <div class="periwinkle-journal-index__media">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 550, 750, 1000, 1200',
                      sizes: '(min-width: 1300px) 400px, (min-width: 990px) 30vw, (min-width: 750px) 45vw, calc(100vw - 3rem)',
                      alt: article.image.alt,
                      class: 'periwinkle-journal-index__image',
                      style: image_position
                  }}
                {%- endif -%}
              </div>
              {%- if article.tags.size > 0 -%}
                <p class="periwinkle-journal-index__topic">{{ article.tags.first | escape }}</p>
              {%- endif -%}
              <h3 class="periwinkle-journal-index__title">
                <a href="{{ article.url }}" class="periwinkle-journal-index__link">{{ article.title | escape }}</a>
              </h3>
              {{ card_meta }}
              <p class="periwinkle-journal-index__summary periwinkle-journal-index__summary--clamp">{{ summary }}</p>
            </article>
          </li>

          {%- if forloop.last -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        <div class="periwinkle-journal-index__pagination">
          {% render 'pagination', paginate: paginate %}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Peri journal index",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Periwinkle Journal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the blog’s title.",
      "default": "Stories of <em>craft and travel.</em>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Notes from the looms, workshops and far-off markets behind the things we make and find.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show topic filters",
      "info": "Shown when stories use at least two different tags.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "feature_latest",
      "label": "Feature the latest story",
      "default": true
    },
    {
      "type": "text",
      "id": "more_heading",
      "label": "Heading above other stories",
      "default": "More stories"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Stories per page",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2E2C35"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#4F4A70"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ]
}
{% endschema %}
